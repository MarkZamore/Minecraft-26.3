type="required"
versionRange="[@MINECRAFT@,)"
ordering="NONE"
side="CLIENT"

[[dependencies.lanmc_pause_actions]]
modId="neoforge"
type="required"
versionRange="[@NEOFORGE@,)"
ordering="NONE"
side="CLIENT"
